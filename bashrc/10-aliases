# -----------------------------------------------------
# ALIASES
# -----------------------------------------------------

# -----------------------------------------------------
# General
# -----------------------------------------------------
alias ..='cd ..'
alias c='clear'
alias nf='fastfetch'
alias pf='fastfetch'
alias ff='fastfetch'
alias ls='eza -a --icons=always'
alias ll='eza -al --icons=always'
alias lt='eza -a --tree --level=1 --icons=always'
alias shutdown='~/.config/jay/scripts/jay-power -p'
alias v='$EDITOR'
alias vim='$EDITOR'
alias wifi='nmtui'
alias arch-cleanup='~/.config/jay/scripts/arch/cleanup.sh'
alias apps='~/.config/jay/bin/jay-apps'
alias screenshot='~/.config/jay/bin/jay-screenshot'
alias updates='~/.config/jay/scripts/jay-install-system-updates'
alias filemanager='~/.config/jay/settings/filemanager'
alias autostart='~/.config/jay/scripts/jay-autostart'
alias lock='hyprlock'
alias clock='tty-clock'
alias system='~/.config/jay/settings/systemmonitor'
alias quick='~/.config/jay/bin/jay-quicklinks'
alias wallpaper='~/.config/jay/bin/jay-wallpaper'
alias settings='jay-dotfiles-settings com.jay.dotfiles'

# -----------------------------------------------------
# ML4W Apps
# -----------------------------------------------------
alias jay='qs ipc call welcome toggle'
alias jay-settings='qs -p ~/.local/share/jay-dotfiles-settings/quickshell ipc call settings toggle'
alias jay-calendar='qs ipc call calendar toggle'
alias jay-hyprland='flatpak run com.jay.hyprlandsettings'
alias jay-sidebar='qs ipc call sidebar toggle'

# -----------------------------------------------------
# Git
# -----------------------------------------------------
alias gs="git status"
alias ga="git add"
alias gc="git commit -m"
alias gp="git push"
alias gpl="git pull"
alias gst="git stash"
alias gsp="git stash; git pull"
alias gfo="git fetch origin"
alias gcheck="git checkout"
alias gcredential="git config credential.helper store"

# -----------------------------------------------------
# Scripts
# -----------------------------------------------------
alias ascii='~/.config/jay/scripts/jay-ascii-header'

# -----------------------------------------------------
# System
# -----------------------------------------------------
alias update-grub='sudo grub-mkconfig -o /boot/grub/grub.cfg'

# -----------------------------------------------------
# fastfetch
# -----------------------------------------------------
alias fastfetchTheme="$HOME/.config/fastfetch/fftheme.sh"
alias fft=fastfetchTheme
alias ff="$HOME/.config/fastfetch/launch.sh"
alias fastfetch='ff'
