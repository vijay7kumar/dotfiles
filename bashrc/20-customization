# -----------------------------------------------------
# CUSTOMIZATION
# -----------------------------------------------------
POSH=agnoster

# -----------------------------------------------------
# Prompt
# -----------------------------------------------------
# oh-my-posh if installed + configured, otherwise starship
if command -v oh-my-posh >/dev/null && [[ -f $HOME/.config/ohmyposh/zen.toml ]]; then
    eval "$(oh-my-posh init bash --config $HOME/.config/ohmyposh/zen.toml)"
elif command -v starship >/dev/null; then
    eval "$(starship init bash)"
fi
