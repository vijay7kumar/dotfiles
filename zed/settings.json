{
  "formatter": "language_server",
  "git": {
    "disable_git": false,
  },
  "proxy": "",
  "vim_mode": true,
  "relative_line_numbers": "enabled",
  "vim": {
    "toggle_relative_line_numbers": true,
    "use_smartcase_find": true,
    "gdefault": true,
    "highlight_on_yank_duration": 50,
  },
  "scrollbar": {
    "show": "always",
  },
  "scroll_beyond_last_line": "off",
  "vertical_scroll_margin": 0,
  "cursor_blink": false,
  "agent": {
    "default_model": {
      "provider": "copilot_chat",
      "model": "claude-haiku-4.5",
      "enable_thinking": true,
    },
    "dock": "left",
    "favorite_models": [],
    "model_parameters": [],
  },
  "debugger": {
    "dock": "bottom",
  },
  "outline_panel": {
    "dock": "right",
  },
  "collaboration_panel": {
    "dock": "right",
  },
  "git_panel": {
    "tree_view": true,
    "dock": "right",
  },
  "project_panel": {
    "dock": "left",
  },
  "terminal": {
    "dock": "bottom",
    "font_size":16
  },
  "edit_predictions": {
    "provider": "zed",
    "open_ai_compatible_api": {
      "api_url": "",
    },
  },
  "cli_default_open_behavior": "existing_window",
  "base_keymap": "VSCode",
  "agent_servers": {
    "gemini": {
      "type": "registry",
    },
    "opencode": {
      "type": "registry",
    },
    "claude-acp": {
      "type": "registry",
    },
    "github-copilot-cli": {
      "type": "registry",
    },
  },
  "icon_theme": {
    "mode": "light",
    "light": "Catppuccin Frappé",
    "dark": "Catppuccin Macchiato",
  },
  "ui_font_size": 17,
  "buffer_font_size": 18,
  "theme": {
    "mode": "dark",
    "light": "Ayu Light",
    "dark": "Catppuccin Macchiato - No Italics",
  },
}
